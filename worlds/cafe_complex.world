<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <actor name="actor_stable">
      <pose>0 0 0 0 0 0</pose>
      
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>

      <link name="link">
        <collision name="collision">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.5 0.5 1.8</size>
            </box>
          </geometry>
        </collision>
      </link>

      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking" tension="0.6">
            <waypoint><time>0</time><pose>0 0 0 0 0 0</pose></waypoint>
            
            <waypoint><time>6.0</time><pose>2 0 0 0 0 0</pose></waypoint>
            
            <waypoint><time>7.5</time><pose>2 0 0 0 0 1.57</pose></waypoint>
            
            <waypoint><time>12.0</time><pose>2 2 0 0 0 1.57</pose></waypoint>
            <waypoint><time>13.5</time><pose>2 2 0 0 0 3.142</pose></waypoint>
            
            <waypoint><time>18.0</time><pose>0 2 0 0 0 3.142</pose></waypoint>
            <waypoint><time>19.5</time><pose>0 2 0 0 0 -1.57</pose></waypoint>
            
            <waypoint><time>24.0</time><pose>0 0 0 0 0 -1.57</pose></waypoint>
            <waypoint><time>25.5</time><pose>0 0 0 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

  </world>
</sdf>